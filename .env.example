NODE_ENV=development
PORT=4000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cloak_room_billing
DB_POOL_LIMIT=20
JWT_ACCESS_SECRET=change_me_min_32_chars
JWT_REFRESH_SECRET=change_me_min_32_chars_too
JWT_ACCESS_TTL=12h
JWT_REFRESH_TTL=30d
CORS_ORIGINS=http://localhost:3000
REDIS_URL=
SUPER_ADMIN_USER_ID=superadmin
SUPER_ADMIN_PASSWORD=ChangeMe@123
LOG_LEVEL=info

# Optional (defaults shown)
# CLUSTER_WORKERS=0          # 0 = one per CPU in production, 1 otherwise
# TRUST_PROXY=loopback       # express "trust proxy" (hops number or subnet list)
# SHUTDOWN_TIMEOUT_MS=15000
# DOWNLOADS_DIR=downloads     # APKs served at /downloads
# RATE_LIMIT_MULTIPLIER=1     # load testing only; rejected in production
