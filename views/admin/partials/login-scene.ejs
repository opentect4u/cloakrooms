  </g>

  <!-- conveyor with bags -->
  <rect x="-600" y="590" width="1840" height="16" rx="8" fill="#fff" opacity=".12"/>
  <g class="rollers" fill="#C7D2FE" fill-opacity=".35" stroke="#E0E7FF" stroke-opacity=".5">
    <g class="roller"><circle cx="40" cy="598" r="6"/><path d="M34 598h12M40 592v12" stroke-width="1.4"/></g>
    <g class="roller"><circle cx="160" cy="598" r="6"/><path d="M154 598h12M160 592v12" stroke-width="1.4"/></g>
    <g class="roller"><circle cx="280" cy="598" r="6"/><path d="M274 598h12M280 592v12" stroke-width="1.4"/></g>
    <g class="roller"><circle cx="400" cy="598" r="6"/><path d="M394 598h12M400 592v12" stroke-width="1.4"/></g>
    <g class="roller"><circle cx="520" cy="598" r="6"/><path d="M514 598h12M520 592v12" stroke-width="1.4"/></g>
    <g class="roller"><circle cx="620" cy="598" r="6"/><path d="M614 598h12M620 592v12" stroke-width="1.4"/></g>
    <g class="roller"><circle cx="-280" cy="598" r="6"/><path d="M-286 598h12M-280 592v12" stroke-width="1.4"/></g>
    <g class="roller"><circle cx="-160" cy="598" r="6"/><path d="M-166 598h12M-160 592v12" stroke-width="1.4"/></g>
    <g class="roller"><circle cx="-80" cy="598" r="6"/><path d="M-86 598h12M-80 592v12" stroke-width="1.4"/></g>
    <g class="roller"><circle cx="740" cy="598" r="6"/><path d="M734 598h12M740 592v12" stroke-width="1.4"/></g>
    <g class="roller"><circle cx="860" cy="598" r="6"/><path d="M854 598h12M860 592v12" stroke-width="1.4"/></g>
    <g class="roller"><circle cx="980" cy="598" r="6"/><path d="M974 598h12M980 592v12" stroke-width="1.4"/></g>
  </g>

  <g class="bag bag-1">
    <g class="bag-bob">
      <path d="M18 528 v-8 a4 4 0 0 1 4 -4 h14 a4 4 0 0 1 4 4 v8" fill="none" stroke="#FCD34D" stroke-width="4"/>
      <rect x="4" y="528" width="50" height="58" rx="9" fill="#F59E0B"/>
      <path d="M20 532v50M38 532v50" stroke="#B45309" stroke-opacity=".5" stroke-width="3"/>
      <g class="tag"><line x1="48" y1="532" x2="58" y2="548" stroke="#FEF3C7" stroke-width="1.5"/><rect x="52" y="546" width="14" height="10" rx="2" fill="#FEF3C7"/></g>
