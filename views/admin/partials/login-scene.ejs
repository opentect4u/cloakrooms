      <rect x="56" y="480" width="44" height="42" rx="6"/><rect x="106" y="480" width="44" height="42" rx="6"/>
      <rect x="156" y="480" width="44" height="42" rx="6"/><rect x="206" y="480" width="44" height="42" rx="6"/>
