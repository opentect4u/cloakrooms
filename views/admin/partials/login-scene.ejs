      <path d="M22 556 q18 -22 36 0" fill="none" stroke="#5EEAD4" stroke-width="4"/>
      <rect x="0" y="552" width="80" height="36" rx="18" fill="#14B8A6"/>
      <path d="M8 570h64" stroke="#0F766E" stroke-opacity=".6" stroke-width="3" stroke-dasharray="4 4"/>
      <g class="tag"><line x1="10" y1="558" x2="2" y2="572" stroke="#CCFBF1" stroke-width="1.5"/><rect x="-8" y="570" width="14" height="10" rx="2" fill="#CCFBF1"/></g>
    </g>
  </g>
  <g class="bag bag-3">
    <g class="bag-bob">
      <rect x="2" y="530" width="44" height="56" rx="15" fill="#F472B6"/>
      <rect x="10" y="556" width="28" height="22" rx="7" fill="#DB2777" opacity=".55"/>
      <path d="M14 532 q10 -12 20 0" fill="none" stroke="#FBCFE8" stroke-width="3.5"/>
      <g class="tag"><line x1="40" y1="540" x2="50" y2="552" stroke="#FCE7F3" stroke-width="1.5"/><rect x="44" y="550" width="14" height="10" rx="2" fill="#FCE7F3"/></g>
    </g>
  </g>
</svg>
