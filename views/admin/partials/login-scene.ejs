        <rect x="513" y="331" width="11" height="3" rx="1.5" fill="#CBD5E1"/>
        <rect x="513" y="337" width="9" height="3" rx="1.5" fill="#CBD5E1"/>
        <rect x="489" y="356" width="35" height="5" rx="2.5" fill="#F59E0B"/>
      </g>
    </g>
    <rect x="466" y="372" width="80" height="22" rx="7" fill="#E0E7FF"/>
    <rect x="476" y="370" width="60" height="5" rx="2.5" fill="#1E1B4B"/>
    <circle class="led l1" cx="536" cy="385" r="2.6"/>
    <rect x="400" y="366" width="52" height="26" rx="5" fill="#1E1B4B" stroke="#C7D2FE" stroke-opacity=".6"/>
    <rect x="404" y="370" width="44" height="18" rx="3" fill="#4F46E5" opacity=".7"/>
