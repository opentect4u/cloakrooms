      <rect x="190" y="400" width="3" height="10" rx="1.5"/><rect x="240" y="400" width="3" height="10" rx="1.5"/>
      <rect x="90" y="448" width="3" height="10" rx="1.5"/><rect x="140" y="448" width="3" height="10" rx="1.5"/>
      <rect x="190" y="448" width="3" height="10" rx="1.5"/><rect x="240" y="448" width="3" height="10" rx="1.5"/>
      <rect x="90" y="496" width="3" height="10" rx="1.5"/><rect x="140" y="496" width="3" height="10" rx="1.5"/>
      <rect x="190" y="496" width="3" height="10" rx="1.5"/><rect x="240" y="496" width="3" height="10" rx="1.5"/>
    </g>
    <circle class="led l1" cx="66" cy="393" r="3"/>
    <circle class="led l2" cx="166" cy="393" r="3"/>
    <circle class="led l3" cx="116" cy="441" r="3"/>
    <circle class="led l1" cx="216" cy="441" r="3"/>
    <circle class="led l2" cx="66" cy="489" r="3"/>
    <circle class="led l3" cx="166" cy="489" r="3"/>
  </g>

  <!-- counter, printer and printing receipt -->
  <g class="counter">
    <rect x="378" y="390" width="230" height="22" rx="8" fill="#C7D2FE" opacity=".35"/>
    <rect x="392" y="412" width="202" height="118" rx="10" fill="#fff" opacity=".07"/>
    <g clip-path="url(#sc-printer-slot)">
      <g class="receipt">
        <rect x="482" y="300" width="48" height="74" rx="3" fill="#fff"/>
        <rect x="489" y="308" width="24" height="4" rx="2" fill="#4F46E5"/>
        <rect x="489" y="316" width="34" height="3" rx="1.5" fill="#CBD5E1"/>
        <rect x="489" y="322" width="28" height="3" rx="1.5" fill="#CBD5E1"/>
        <g fill="#1E1B4B">
          <rect x="489" y="330" width="6" height="6"/><rect x="497" y="330" width="3" height="3"/>
          <rect x="503" y="330" width="6" height="6"/><rect x="489" y="339" width="3" height="3"/>
          <rect x="495" y="338" width="4" height="4"/><rect x="503" y="339" width="3" height="3"/>
          <rect x="489" y="344" width="6" height="6"/><rect x="498" y="345" width="4" height="4"/>
          <rect x="504" y="344" width="5" height="5"/>
