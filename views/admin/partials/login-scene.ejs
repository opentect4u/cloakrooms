<%# Animated cloak-room scene: station at night, passing train, lockers, conveyor of bags, printing receipt. Pure SVG + CSS (admin.css "Login scene"); motion stops under prefers-reduced-motion. %>
<svg class="scene" viewBox="0 0 640 640" preserveAspectRatio="xMidYMax meet" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="sc-glow" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#A5B4FC" stop-opacity=".55"/>
      <stop offset="1" stop-color="#A5B4FC" stop-opacity="0"/>
    </linearGradient>
    <linearGradient id="sc-platform" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#0B0F2E" stop-opacity=".25"/>
      <stop offset="1" stop-color="#070A20" stop-opacity=".85"/>
    </linearGradient>
    <linearGradient id="sc-train" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#E0E7FF"/>
      <stop offset="1" stop-color="#A5B4FC"/>
    </linearGradient>
    <pattern id="sc-sleepers" width="18" height="10" patternUnits="userSpaceOnUse">
      <rect x="2" y="0" width="8" height="10" rx="1.5" fill="#fff" opacity=".12"/>
    </pattern>
    <pattern id="sc-stripe" width="24" height="6" patternUnits="userSpaceOnUse">
      <rect width="12" height="6" fill="#F59E0B"/>
      <rect x="12" width="12" height="6" fill="#1E1B4B"/>
    </pattern>
    <clipPath id="sc-printer-slot">
      <rect x="474" y="292" width="64" height="98"/>
    </clipPath>
  </defs>

  <!-- sky -->
  <g class="stars">
    <circle class="star s1" cx="62" cy="58" r="1.6"/>
    <circle class="star s2" cx="148" cy="112" r="1.2"/>
    <circle class="star s3" cx="236" cy="40" r="1.8"/>
    <circle class="star s4" cx="408" cy="70" r="1.3"/>
    <circle class="star s5" cx="566" cy="36" r="1.7"/>
    <circle class="star s6" cx="602" cy="128" r="1.2"/>
    <circle class="star s2" cx="470" cy="128" r="1"/>
    <circle class="star s4" cx="30" cy="160" r="1.1"/>
    <circle class="star s1" cx="-90" cy="90" r="1.4"/>
    <circle class="star s5" cx="-60" cy="210" r="1.1"/>
    <circle class="star s3" cx="700" cy="60" r="1.5"/>
    <circle class="star s6" cx="730" cy="190" r="1.2"/>
  </g>
  <circle cx="548" cy="96" r="30" fill="#E0E7FF" opacity=".9"/>
  <circle cx="560" cy="88" r="30" fill="#312E81" opacity=".95"/>

  <!-- station building -->
  <g class="station">
    <path d="M104 196 Q320 70 536 196 Z" fill="#fff" opacity=".09"/>
    <path d="M104 196 Q320 70 536 196" fill="none" stroke="#fff" stroke-opacity=".25" stroke-width="2"/>
    <rect x="120" y="192" width="400" height="104" fill="#fff" opacity=".06"/>
    <g fill="url(#sc-glow)">
      <path d="M150 296 V244 a22 22 0 0 1 44 0 V296 Z"/>
      <path d="M222 296 V244 a22 22 0 0 1 44 0 V296 Z"/>
      <path d="M374 296 V244 a22 22 0 0 1 44 0 V296 Z"/>
      <path d="M446 296 V244 a22 22 0 0 1 44 0 V296 Z"/>
    </g>
    <path d="M290 296 V236 a30 30 0 0 1 60 0 V296 Z" fill="#FDE68A" opacity=".22"/>
    <circle cx="320" cy="148" r="27" fill="#1E1B4B" stroke="#C7D2FE" stroke-opacity=".7" stroke-width="3"/>
    <g stroke="#E0E7FF" stroke-linecap="round">
      <line x1="320" y1="126" x2="320" y2="130" stroke-width="2"/>
      <line x1="342" y1="148" x2="338" y2="148" stroke-width="2"/>
      <line x1="320" y1="170" x2="320" y2="166" stroke-width="2"/>
      <line x1="298" y1="148" x2="302" y2="148" stroke-width="2"/>
      <line x1="320" y1="148" x2="320" y2="134" stroke-width="3"/>
      <line class="clock-hand" x1="320" y1="148" x2="333" y2="148" stroke-width="2"/>
    </g>
    <circle cx="320" cy="148" r="2.5" fill="#F59E0B"/>
    <rect x="262" y="198" width="116" height="18" rx="4" fill="#F59E0B" opacity=".9"/>
    <text x="320" y="211" text-anchor="middle" class="scene-sign">CLOAK ROOM</text>
  </g>

  <!-- track + passing train -->
  <rect x="-600" y="322" width="1840" height="10" fill="url(#sc-sleepers)"/>
  <line x1="-600" y1="322" x2="1240" y2="322" stroke="#fff" stroke-opacity=".28" stroke-width="2"/>
  <line x1="-600" y1="331" x2="1240" y2="331" stroke="#fff" stroke-opacity=".18" stroke-width="2"/>
  <g class="train">
    <path d="M0 270 H128 Q150 270 156 292 L160 316 H0 Z" fill="url(#sc-train)"/>
    <rect x="-170" y="270" width="162" height="46" rx="8" fill="url(#sc-train)"/>
    <rect x="-340" y="270" width="162" height="46" rx="8" fill="url(#sc-train)"/>
    <g fill="#312E81" opacity=".85">
      <rect x="18" y="280" width="26" height="16" rx="3"/>
      <rect x="54" y="280" width="26" height="16" rx="3"/>
      <rect x="90" y="280" width="26" height="16" rx="3"/>
      <path d="M126 280 H138 Q146 282 148 296 H126 Z"/>
      <rect x="-156" y="280" width="26" height="16" rx="3"/>
      <rect x="-120" y="280" width="26" height="16" rx="3"/>
      <rect x="-84" y="280" width="26" height="16" rx="3"/>
      <rect x="-48" y="280" width="26" height="16" rx="3"/>
      <rect x="-326" y="280" width="26" height="16" rx="3"/>
      <rect x="-290" y="280" width="26" height="16" rx="3"/>
      <rect x="-254" y="280" width="26" height="16" rx="3"/>
      <rect x="-218" y="280" width="26" height="16" rx="3"/>
    </g>
    <g fill="#FDE68A">
      <rect x="18" y="280" width="26" height="6" rx="2" opacity=".5"/>
      <rect x="-120" y="280" width="26" height="6" rx="2" opacity=".5"/>
      <rect x="-254" y="280" width="26" height="6" rx="2" opacity=".5"/>
    </g>
    <rect x="-340" y="302" width="500" height="4" fill="#F59E0B" opacity=".8"/>
    <circle cx="150" cy="306" r="3" fill="#FEF3C7"/>
    <g fill="#1E1B4B">
      <circle cx="24" cy="318" r="5"/><circle cx="110" cy="318" r="5"/>
      <circle cx="-146" cy="318" r="5"/><circle cx="-30" cy="318" r="5"/>
      <circle cx="-316" cy="318" r="5"/><circle cx="-200" cy="318" r="5"/>
    </g>
  </g>

  <!-- platform -->
  <rect x="-600" y="338" width="1840" height="402" fill="url(#sc-platform)"/>
  <rect x="-600" y="338" width="1840" height="6" fill="url(#sc-stripe)" opacity=".85"/>

  <!-- lockers -->
  <g class="lockers">
    <rect x="44" y="372" width="214" height="160" rx="12" fill="#fff" opacity=".07"/>
    <g fill="#fff" fill-opacity=".1" stroke="#fff" stroke-opacity=".22">
      <rect x="56" y="384" width="44" height="42" rx="6"/><rect x="106" y="384" width="44" height="42" rx="6"/>
      <rect x="156" y="384" width="44" height="42" rx="6"/><rect x="206" y="384" width="44" height="42" rx="6"/>
