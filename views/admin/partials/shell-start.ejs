<%- include('head') %>
<body class="admin-body">
<a class="skip-link" href="#main">Skip to content</a>
<div class="shell">
  <aside class="sidebar" id="sidebar" aria-label="Main navigation">
    <div class="sidebar-brand">
      <a href="/admin" class="brand-link">
        <%- include('brand') %>
        <span class="brand-text">
          <span class="brand-name">Cloak Room</span>
          <span class="brand-sub">Super admin</span>
        </span>
      </a>
      <button class="btn-icon sidebar-close d-lg-none" type="button" data-sidebar-close aria-label="Close menu">
        <i class="bi bi-x-lg"></i>
      </button>
    </div>
    <nav class="sidebar-nav">
      <% nav.forEach(function (item) { %>
        <% if (item.section) { %>
          <div class="nav-section"><%= item.section %></div>
        <% } else if (item.soon) { %>
          <span class="nav-item is-soon" aria-disabled="true" title="Coming in the next update">
            <i class="bi bi-<%= item.icon %>"></i><span><%= item.label %></span><span class="soon-pill">Soon</span>
          </span>
        <% } else { %>
          <a class="nav-item<%= active === item.key ? ' is-active' : '' %>" href="<%= item.href %>"<%- active === item.key ? ' aria-current="page"' : '' %>>
            <i class="bi bi-<%= item.icon %>"></i><span><%= item.label %></span>
          </a>
        <% } %>
      <% }) %>
    </nav>
    <div class="sidebar-foot">
      <div class="sidebar-card">
        <i class="bi bi-cloud-check"></i>
        <div>
          <div class="fw-semibold">All stations, one view</div>
          <div class="small opacity-75">Synergic Softek</div>
        </div>
      </div>
    </div>
  </aside>
  <div class="sidebar-backdrop" data-sidebar-close></div>

  <div class="main">
    <header class="topbar">
      <button class="btn-icon d-lg-none" type="button" data-sidebar-open aria-label="Open menu" aria-controls="sidebar">
        <i class="bi bi-list"></i>
      </button>
      <div class="topbar-title">
        <span class="topbar-crumb">Admin</span>
        <i class="bi bi-chevron-right"></i>
        <span class="topbar-page"><%= title %></span>
      </div>
      <div class="topbar-actions">
        <button class="btn-icon" type="button" data-theme-toggle aria-label="Switch light/dark theme" title="Switch theme">
          <i class="bi bi-moon-stars theme-icon-dark"></i>
          <i class="bi bi-sun theme-icon-light"></i>
        </button>
        <div class="dropdown">
          <button class="user-chip" type="button" data-bs-toggle="dropdown" aria-expanded="false">
            <span class="avatar"><%= initials(me.name) %></span>
            <span class="user-chip-text d-none d-sm-flex">
              <span class="user-chip-name"><%= me.name %></span>
              <span class="user-chip-role">Super admin</span>
            </span>
            <i class="bi bi-chevron-down small d-none d-sm-inline"></i>
          </button>
          <div class="dropdown-menu dropdown-menu-end shadow-lg user-menu">
            <div class="px-3 py-2">
              <div class="fw-semibold"><%= me.name %></div>
              <div class="small text-body-secondary"><%= me.loginId %></div>
              <% if (me.lastLogin) { %>
                <div class="small text-body-tertiary mt-1">Signed in <%= dateTimeIst(me.lastLogin) %> IST</div>
              <% } %>
            </div>
            <div class="dropdown-divider"></div>
            <a class="dropdown-item" href="/admin/change-password"><i class="bi bi-key me-2"></i>Change password</a>
            <form method="post" action="/admin/logout">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="dropdown-item text-danger" type="submit"><i class="bi bi-box-arrow-right me-2"></i>Sign out</button>
            </form>
          </div>
        </div>
      </div>
    </header>

    <main class="content" id="main" tabindex="-1">
      <%- include('flash') %>
