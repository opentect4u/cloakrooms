<%- include('partials/shell-start') %>
<a class="back-link" href="<%= cancel %>"><i class="bi bi-arrow-left"></i> <%= backLabel %></a>
<div class="page-head">
  <div>
    <h1 class="page-title"><%= heading %></h1>
    <% if (typeof sub !== 'undefined' && sub) { %><p class="page-sub"><%= sub %></p><% } %>
  </div>
</div>
<div class="row g-4">
  <div class="col-xl-8">
    <form class="card card-soft form-card" method="post" action="<%= action %>" data-busy-form novalidate autocomplete="off">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <%- include('partials/form-errors', { fields: fields }) %>
      <div class="row g-3">
        <% fields.forEach(function (f) { %><%- include('partials/field', { f: f }) %><% }) %>
      </div>
      <div class="form-actions">
        <a class="btn btn-light" href="<%= cancel %>">Cancel</a>
        <button class="btn btn-primary" type="submit">
          <span class="btn-label"><i class="bi bi-check2 me-1"></i><%= submitLabel %></span>
          <span class="btn-busy"><span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Saving…</span>
        </button>
      </div>
    </form>
  </div>
  <% if (typeof tip !== 'undefined' && tip) { %>
    <div class="col-xl-4">
      <div class="tip-card"><i class="bi bi-info-circle"></i><div class="small"><%= tip %></div></div>
    </div>
  <% } %>
</div>
<%- include('partials/shell-end') %>
