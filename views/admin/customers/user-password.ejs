<%- include('../partials/shell-start') %>
<%- include('../partials/customer-head') %>
<% var pwField = { name: 'password', label: 'New temporary password', type: 'password', required: true, autocomplete: 'new-password', help: 'At least 8 characters with a letter and a digit.' }; %>

<div class="row g-4">
  <div class="col-xl-7">
    <form class="card card-soft form-card" method="post" action="<%= action %>" data-busy-form novalidate autocomplete="off">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-card-head">
        <a class="back-link mb-2" href="<%= cancel %>"><i class="bi bi-arrow-left"></i> Users</a>
        <h2 class="card-title"><i class="bi bi-key me-2 text-primary"></i>Reset password for <%= user.user_name %></h2>
        <p class="card-sub mb-0">Their device is signed out (it can still upload pending data) and they must choose a new password at next sign-in.</p>
      </div>
      <%- include('../partials/form-errors', { fields: [pwField] }) %>
      <div class="row g-3">
        <%- include('../partials/field', { f: pwField, values: {} }) %>
      </div>
      <div class="form-actions">
        <a class="btn btn-light" href="<%= cancel %>">Cancel</a>
        <button class="btn btn-primary" type="submit">
          <span class="btn-label"><i class="bi bi-check2 me-1"></i>Reset password</span>
          <span class="btn-busy"><span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Saving…</span>
        </button>
      </div>
    </form>
  </div>
</div>
<%- include('../partials/shell-end') %>
