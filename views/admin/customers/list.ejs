<%- include('../partials/shell-start') %>
<div class="page-head">
  <div>
    <h1 class="page-title">Customers</h1>
    <p class="page-sub">Every cloak room on the platform: subscriptions, users and settings.</p>
  </div>
  <div class="page-actions">
    <a class="btn btn-primary btn-glow" href="/admin/customers/new"><i class="bi bi-plus-lg me-1"></i>New customer</a>
  </div>
</div>

<form class="filter-bar" method="get" action="/admin/customers" role="search" data-autosubmit>
  <div class="input-icon filter-search">
    <i class="bi bi-search"></i>
    <input class="form-control" type="search" name="q" value="<%= q %>" placeholder="Search name, mobile or GSTIN" aria-label="Search customers">
  </div>
  <select class="form-select" name="status" aria-label="Status">
    <option value="">All statuses</option>
    <% [['active','Active'],['inactive','Inactive'],['expired','Subscription expired'],['none','No subscription']].forEach(function (o) { %>
      <option value="<%= o[0] %>"<%= f.status === o[0] ? ' selected' : '' %>><%= o[1] %></option>
    <% }) %>
  </select>
  <select class="form-select" name="state" aria-label="State">
    <option value="">All states</option>
    <% states.forEach(function (s) { %><option value="<%= s %>"<%= f.state === s ? ' selected' : '' %>><%= s %></option><% }) %>
  </select>
  <select class="form-select" name="sort" aria-label="Sort">
    <option value="name"<%= !f.sort || f.sort === 'name' ? ' selected' : '' %>>Name A–Z</option>
    <option value="renewal"<%= f.sort === 'renewal' ? ' selected' : '' %>>Renewal date</option>
    <option value="newest"<%= f.sort === 'newest' ? ' selected' : '' %>>Newest first</option>
  </select>
  <button class="btn btn-light autosave-btn" type="submit"><i class="bi bi-funnel me-1"></i>Apply</button>
  <% if (q || f.status || f.state || f.sort) { %><a class="btn-link-plain small" href="/admin/customers"><i class="bi bi-x-circle"></i> Clear</a><% } %>
</form>

<div class="card card-soft">
  <% if (!rows.length) { %>
    <div class="empty-state empty-state-md">
      <div class="empty-icon"><i class="bi bi-buildings"></i></div>
      <div class="empty-title-sm"><%= (q || f.status || f.state) ? 'No customers match these filters' : 'No customers yet' %></div>
      <div class="empty-text small"><%= (q || f.status || f.state) ? 'Try another search or clear the filters.' : 'Create the first cloak room to get started.' %></div>
      <a class="btn btn-primary" href="/admin/customers/new"><i class="bi bi-plus-lg me-1"></i>New customer</a>
    </div>
  <% } else { %>
    <div class="table-responsive">
      <table class="table table-modern align-middle mb-0">
        <thead>
          <tr>
            <th scope="col">Cloak room</th>
            <th scope="col" class="d-none d-md-table-cell">Contact</th>
            <th scope="col">Subscription</th>
            <th scope="col" class="d-none d-sm-table-cell">Users</th>
            <th scope="col" class="d-none d-lg-table-cell">Status</th>
            <th scope="col" class="text-end"><span class="visually-hidden">Open</span></th>
          </tr>
        </thead>
        <tbody>
          <% rows.forEach(function (c) { var s = c.subscription; var pct = Math.min(100, Math.round((c.seats.allowed / Math.max(1, c.user_limit)) * 100)); %>
            <tr class="row-link">
              <td>
                <a class="cell-main" href="/admin/customers/<%= c.customer_id %>">
                  <span class="avatar avatar-soft"><%= initials(c.customer_name) %></span>
                  <span>
                    <span class="list-title d-block"><%= c.customer_name %></span>
                    <span class="list-sub"><%= c.state || 'State not set' %> · #<%= c.customer_id %></span>
                  </span>
                </a>
              </td>
              <td class="d-none d-md-table-cell">
                <div><%= c.mobile_no %></div>
                <div class="list-sub"><%= c.gst_no || 'No GSTIN' %></div>
              </td>
              <td>
                <span class="pill pill-<%= s.tone === 'success' ? 'success' : s.tone %>"><i class="bi bi-<%= s.tone === 'success' ? 'calendar-check' : s.tone === 'warning' ? 'hourglass-split' : 'calendar-x' %>"></i><%= s.label %></span>
                <% if (c.renewal_dt) { %><div class="list-sub mt-1">Renews <%= date(c.renewal_dt) %></div><% } %>
              </td>
              <td class="d-none d-sm-table-cell">
                <div class="seat-line"><strong><%= c.seats.allowed %></strong><span class="text-body-tertiary"> / <%= c.user_limit %></span>
                  <% if (c.seats.online) { %><span class="online-chip"><span class="live-dot"></span><%= c.seats.online %> online</span><% } %>
                </div>
                <svg class="meter" viewBox="0 0 100 6" preserveAspectRatio="none" aria-hidden="true"><rect class="meter-track" width="100" height="6" rx="3"/><rect class="meter-fill<%= pct >= 100 ? ' is-full' : '' %>" width="<%= Math.max(pct, 2) %>" height="6" rx="3"/></svg>
              </td>
              <td class="d-none d-lg-table-cell">
                <% if (c.active_flag === 'Y') { %><span class="status-dot is-on">Active</span><% } else { %><span class="status-dot is-off">Inactive</span><% } %>
              </td>
              <td class="text-end"><a class="btn-icon btn-icon-sm" href="/admin/customers/<%= c.customer_id %>" aria-label="Open <%= c.customer_name %>"><i class="bi bi-chevron-right"></i></a></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <%- include('../partials/pager') %>
  <% } %>
</div>
<%- include('../partials/shell-end') %>
