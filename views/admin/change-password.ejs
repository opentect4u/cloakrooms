<%- include('partials/shell-start') %>
<div class="page-head">
  <div>
    <h1 class="page-title">Change password</h1>
    <p class="page-sub">Use at least 8 characters with a letter and a digit.</p>
  </div>
</div>

<div class="row g-4">
  <div class="col-xl-6 col-lg-8">
    <% if (me.mustChange) { %>
      <div class="callout callout-warning mb-4">
        <i class="bi bi-shield-exclamation"></i>
        <div>
          <div class="fw-semibold">Set your own password to continue</div>
          <div class="small">Your password was set by an administrator. Choose a new one before using the panel.</div>
        </div>
      </div>
    <% } %>
    <div class="card card-soft">
      <div class="card-body p-4">
        <form method="post" action="/admin/change-password" data-busy-form novalidate>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <% [
               ['current_password', 'Current password', 'current-password'],
               ['new_password', 'New password', 'new-password'],
               ['confirm_password', 'Confirm new password', 'new-password'],
             ].forEach(function (f) { var err = errors[f[0]]; %>
            <div class="mb-3">
              <label class="form-label" for="<%= f[0] %>"><%= f[1] %></label>
              <div class="input-icon">
                <i class="bi bi-<%= f[0] === 'current_password' ? 'lock' : 'key' %>"></i>
                <input class="form-control<%= err ? ' is-invalid' : '' %>" id="<%= f[0] %>" name="<%= f[0] %>" type="password"
                       autocomplete="<%= f[2] %>" required<%- err ? ' aria-describedby="' + f[0] + '-err"' : '' %>>
                <button class="input-action" type="button" data-toggle-password="<%= f[0] %>" aria-label="Show password">
                  <i class="bi bi-eye"></i>
                </button>
              </div>
              <% if (err) { %><div class="field-error" id="<%= f[0] %>-err"><i class="bi bi-exclamation-circle"></i> <%= err %></div><% } %>
              <% if (f[0] === 'new_password') { %>
                <div class="pw-meter" data-pw-meter="new_password" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
              <% } %>
            </div>
          <% }) %>
          <div class="d-flex gap-2 mt-4">
            <button class="btn btn-primary" type="submit">
              <span class="btn-label"><i class="bi bi-check2 me-1"></i>Update password</span>
              <span class="btn-busy"><span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Saving…</span>
            </button>
            <% if (!me.mustChange) { %><a class="btn btn-light" href="/admin">Cancel</a><% } %>
          </div>
        </form>
      </div>
    </div>
  </div>
  <div class="col-xl-4 col-lg-4">
    <div class="tip-card">
      <i class="bi bi-lightbulb"></i>
      <div>
        <div class="fw-semibold mb-1">Good passwords</div>
        <ul class="small mb-0 ps-3">
          <li>8–128 characters, at least one letter and one digit</li>
          <li>Different from your current password</li>
          <li>Not shared with any other system</li>
        </ul>
      </div>
    </div>
  </div>
</div>
<%- include('partials/shell-end') %>
