<%- include('partials/shell-start') %>
<div class="page-head">
  <div>
    <h1 class="page-title">Bag search</h1>
    <p class="page-sub">Find a bag by PNR, mobile number, passenger name or receipt number, at one station or everywhere. Shows what has reached the server.</p>
  </div>
</div>

<form class="search-hero card card-soft" method="get" action="/admin/bags" role="search">
  <div class="input-icon search-hero-input">
    <i class="bi bi-search"></i>
    <input class="form-control form-control-lg" type="search" name="q" value="<%= q %>" placeholder="PNR, mobile, name or receipt no." aria-label="Search bags" autofocus>
  </div>
  <select class="form-select form-select-lg" name="customer_id" aria-label="Customer">
    <option value="">All customers</option>
    <% customers.forEach(function (c) { %><option value="<%= c[0] %>"<%= Number(c[0]) === cid ? ' selected' : '' %>><%= c[1] %></option><% }) %>
  </select>
  <select class="form-select form-select-lg" name="status" aria-label="Status">
    <option value="">In store and out</option>
    <option value="in"<%= status === 'in' ? ' selected' : '' %>>In store</option>
    <option value="out"<%= status === 'out' ? ' selected' : '' %>>Checked out</option>
  </select>
  <button class="btn btn-primary btn-lg" type="submit"><i class="bi bi-search me-1"></i>Search</button>
</form>

<div class="card card-soft">
  <% if (!rows.length) { %>
    <div class="empty-state empty-state-md">
      <div class="empty-icon"><i class="bi bi-suitcase2"></i></div>
      <div class="empty-title-sm"><%= q ? 'No bags match “' + q + '”' : 'No bags yet' %></div>
      <div class="empty-text small"><%= q ? 'Check the number, try part of it, or search all customers. A bag checked in on a device that has not synced yet is not on the server.' : 'Check-ins appear here once devices sync.' %></div>
    </div>
  <% } else { %>
    <div class="table-responsive">
      <table class="table table-modern align-middle mb-0">
        <thead><tr>
          <th scope="col">Receipt</th>
          <th scope="col">Passenger</th>
          <th scope="col" class="d-none d-md-table-cell">PNR</th>
          <th scope="col" class="text-end">Bags</th>
          <th scope="col" class="d-none d-lg-table-cell">Checked in</th>
          <% if (!cid) { %><th scope="col" class="d-none d-md-table-cell">Customer</th><% } %>
          <th scope="col">Status</th>
        </tr></thead>
        <tbody>
          <% rows.forEach(function (b) { %>
            <tr>
              <td><a class="cell-link mono" href="/admin/bags/<%= b.trans_id %>"><%= b.receipt_no %></a><div class="list-sub"><%= date(b.receipt_dt) %></div></td>
              <td><span class="fw-semibold"><%= b.pasn_name %></span><div class="list-sub"><%= b.pasn_mob_no %></div></td>
              <td class="d-none d-md-table-cell mono"><%= b.pnr_no || '—' %></td>
              <td class="text-end tabular"><%= b.luggage_qty %></td>
              <td class="d-none d-lg-table-cell list-sub"><%= dateTimeIst(b.date_time_in) %></td>
              <% if (!cid) { %><td class="d-none d-md-table-cell"><a href="/admin/customers/<%= b.customer_id %>"><%= b.customer_name %></a></td><% } %>
              <td><% if (b.out_flag === 'Y') { %><span class="pill pill-muted"><i class="bi bi-box-arrow-up"></i>Out</span><% } else { %><span class="pill pill-success"><i class="bi bi-suitcase2"></i>In store</span><% } %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <%- include('partials/pager') %>
  <% } %>
</div>
<%- include('partials/shell-end') %>
