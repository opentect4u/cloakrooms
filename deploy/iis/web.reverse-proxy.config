<?xml version="1.0" encoding="utf-8"?>
<!--
  Cloak Room Billing behind IIS (reverse proxy) for https://cloakroom.synergicdatabank.com

  IIS terminates HTTPS and forwards every request to the Node app on http://127.0.0.1:3003
  (started separately, e.g. as a Windows service with NSSM; .env: PORT=3003, HOST=127.0.0.1,
  TRUST_PROXY=loopback, NODE_ENV=production).

  Needs on the server (once):
    * IIS URL Rewrite 2.1 + Application Request Routing (ARR) 3.0
    * ARR proxy enabled: IIS Manager > server node > Application Request Routing Cache >
      Server Proxy Settings > "Enable proxy" (keep "Preserve client IP ... X-Forwarded-For").
    * Allowed server variable HTTP_X_FORWARDED_PROTO: IIS Manager > server node (or this site) >
      URL Rewrite > View Server Variables > Add.

  Put this file alone in the site's physical folder (an empty folder, NOT the project folder).
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Certificate renewals (win-acme / Let's Encrypt HTTP-01) are served by IIS itself. -->
        <rule name="ACME challenge" stopProcessing="true">
          <match url="^\.well-known/acme-challenge/.*" />
          <action type="None" />
        </rule>

        <!-- Plain http -> https. -->
        <rule name="Redirect to HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- Everything else goes to the Node app (API, admin panel, downloads, docs). -->
        <rule name="Cloak Room Node app" stopProcessing="true">
          <match url="(.*)" />
          <serverVariables>
            <!-- Tells the app the browser used HTTPS (secure cookies, correct redirects). -->
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:3003/{R:1}" logRewrittenUrl="true" />
        </rule>
      </rules>
    </rewrite>

    <security>
      <!-- Sync pushes can be up to 5 MB; logo uploads 200 KB. -->
      <requestFiltering removeServerHeader="true">
        <requestLimits maxAllowedContentLength="10485760" />
      </requestFiltering>
    </security>

    <!-- The app compresses its own responses and sends its own error JSON / pages. -->
    <urlCompression doStaticCompression="false" doDynamicCompression="false" />
    <httpErrors existingResponse="PassThrough" />

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
