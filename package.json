{
  "name": "cloak-room-billing-api",
  "version": "0.1.0",
  "private": true,
  "description": "Cloak Room Billing SaaS - backend REST API",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint . && node scripts/check-no-delete.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "loadtest": "npm run build && node --import tsx scripts/loadtest.ts",
    "openapi": "tsx scripts/export-openapi.ts",
    "docs:frontend": "vitest run --config vitest.docs.config.mts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/autocannon": "^7.12.7",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/hpp": "^0.2.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.19.43",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.12",
    "autocannon": "^8.0.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "express-list-endpoints": "^7.1.1",
    "globals": "^17.14.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@node-rs/argon2": "^2.2.2",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "rate-limit-redis": "^6.0.2",
    "redis": "^6.3.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  }
}
